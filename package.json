{
  "name": "itkrivoshei-github-io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "test:links:internal": "node scripts/check-internal-links.mjs",
    "test:links:external": "linkinator dist --recurse --retry --retry-errors --retry-errors-count 2 --timeout 15000 --status-code \"999:warn\" --skip \"^https://itkrivoshei.github.io/(?:$|og-image.png)$\"",
    "test:smoke": "playwright test",
    "test:container": "node scripts/test-container.mjs",
    "validate:bundle": "node scripts/check-bundle-size.mjs",
    "format": "prettier --write \"**/*.{astro,js,mjs,cjs,ts,json,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{astro,js,mjs,cjs,ts,json,css,md,yml,yaml}\"",
    "verify": "npm run format:check && npm run lint && npm run check && npm run build && npm run validate:html && npm run validate:bundle && npm run test:links:internal",
    "ready": "npm run format && npm run verify",
    "hooks:install": "git config core.hooksPath .githooks && chmod +x .githooks/*",
    "hooks:remove": "git config --unset core.hooksPath || true"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.4",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^16.5.0",
    "gsap": "^3.15.0",
    "html-validate": "^11.5.2",
    "lenis": "^1.3.23",
    "linkinator": "^7.6.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true
  }
}
