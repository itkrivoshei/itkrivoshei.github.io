{
  "name": "itkrivoshei-github-io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write \"**/*.{astro,js,mjs,cjs,ts,json,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{astro,js,mjs,cjs,ts,json,css,md,yml,yaml}\"",
    "verify": "npm run format:check && npm run check && npm run build",
    "ready": "npm run format && npm run check && npm run build",
    "hooks:install": "git config core.hooksPath .githooks && chmod +x .githooks/*",
    "hooks:remove": "git config --unset core.hooksPath || true"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.3.0",
    "@tsparticles/engine": "^4.1.2",
    "@tsparticles/slim": "^4.1.2",
    "astro": "^6.4.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^0.14.1"
  },
  "overrides": {
    "yaml": "^2.9.0"
  }
}
