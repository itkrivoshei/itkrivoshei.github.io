---
interface ExperienceLink {
  label: string;
  href: string;
}

interface ExperienceItem {
  company: string;
  href?: string;
  note?: string;
  role: string;
  period: string;
  points: string[];
  links?: ExperienceLink[];
}

interface Props {
  item: ExperienceItem;
}

const { item } = Astro.props;
const links = item.links ?? [];

const ExternalLinkIcon = () => (
  <span class="experience-link-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" role="img">
      <path d="M14 5h5v5" />
      <path d="m19 5-8 8" />
      <path d="M12 7H7a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-5" />
    </svg>
  </span>
);
---

<article class="timeline-card">
  <div class="timeline-head">
    <div>
      {
        item.href ? (
          <h3>
            <a class="text-link company-link" href={item.href} target="_blank" rel="noreferrer">
              <span>{item.company}</span>
              <ExternalLinkIcon />
            </a>
          </h3>
        ) : (
          <h3>{item.company}</h3>
        )
      }

      {item.note && <p class="company-note">{item.note}</p>}

      {
        links.length > 0 && (
          <p class="experience-inline-links">
            references:{" "}
            {links.map((link, index) => (
              <>
                <a href={link.href} target="_blank" rel="noreferrer">
                  <span>{link.label}</span>
                  <ExternalLinkIcon />
                </a>
                {index < links.length - 1 && <span class="link-separator"> / </span>}
              </>
            ))}
          </p>
        )
      }

      <p>{item.role}</p>
    </div>

    <span>{item.period}</span>
  </div>

  <ul>
    {item.points.map((point) => <li>{point}</li>)}
  </ul>
</article>
