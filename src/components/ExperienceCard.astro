---
import Icon from "./Icon.astro";
import type { ExperienceItem } from "../data/profile";
import { splitHighlightedText } from "../utils/text";

interface Props {
  item: ExperienceItem;
}

const { item } = Astro.props as Props;
const links = item.links ?? [];
const skills = item.skills;
---

<article class="timeline-card" data-reveal="card">
  <div class="timeline-head">
    <div>
      {
        item.href ? (
          <h3>
            <a
              class="text-link company-link experience-blue-link"
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>{item.company}</span>
              <span class="experience-link-icon" aria-hidden="true">
                <Icon name="external-link" class="external-link-icon" />
              </span>
            </a>
          </h3>
        ) : (
          <h3>{item.company}</h3>
        )
      }

      {item.note && <p class="company-note">{item.note}</p>}

      {
        links.length > 0 && (
          <p class="experience-inline-links">
            references:{" "}
            {links.map((link, index) => (
              <>
                <a
                  class="experience-blue-link"
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{link.label}</span>
                  <span class="experience-link-icon" aria-hidden="true">
                    <Icon name="external-link" class="external-link-icon" />
                  </span>
                </a>
                {index < links.length - 1 && <span class="link-separator"> / </span>}
              </>
            ))}
          </p>
        )
      }

      <p class="experience-role">{item.role}</p>
    </div>

    <span class="experience-period">{item.period}</span>
  </div>

  <ul class="experience-points">
    {
      item.points.map((point) => {
        const pointParts = splitHighlightedText(point.text, point.highlight);

        return (
          <li>
            <span class="terminal-marker" aria-hidden="true">
              ❯
            </span>
            <span>
              {pointParts.map((part) =>
                part.highlighted ? <strong>{part.text}</strong> : part.text,
              )}
            </span>
          </li>
        );
      })
    }
  </ul>

  <ul class="tag-list experience-skill-list">
    {skills.map((skill) => <li>{skill}</li>)}
  </ul>
</article>

<style is:global>
  .timeline-card .experience-blue-link {
    color: var(--terminal-blue);
  }

  .timeline-card .experience-blue-link:hover {
    color: #dbeafe;
  }

  .timeline-card .experience-role {
    color: var(--terminal-green);
  }

  .timeline-card .timeline-head .experience-period {
    color: var(--muted);
  }

  .timeline-card .experience-points {
    display: grid;
    gap: 0.7rem;
    list-style: none;
    margin: 1rem 0 0;
    padding-left: 0;
  }

  .timeline-card .experience-points li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.65rem;
    color: var(--muted);
    line-height: 1.72;
  }

  .timeline-card .terminal-marker {
    color: var(--terminal-green);
    font-family: var(--mono);
    line-height: 1.72;
    opacity: 0.9;
  }

  .timeline-card .experience-points strong {
    color: #e7ffe4;
    font-weight: 650;
  }

  .timeline-card .experience-skill-list {
    margin: 0.85rem 0 0 1.95rem;
    padding-left: 0;
    line-height: 1;
  }

  .timeline-card .experience-skill-list li {
    cursor: default;
    outline: none;
    border-color: rgba(148, 163, 184, 0.18);
    background: transparent;
    color: var(--muted);
  }

  .timeline-card .experience-skill-list li:hover,
  .timeline-card .experience-skill-list li:active {
    border-color: rgba(var(--accent-rgb), 0.52);
    background: rgba(var(--accent-rgb), 0.07);
    box-shadow: 0 0 18px rgba(var(--accent-rgb), 0.09);
    color: #e7ffe4;
    transform: scale(1.006);
  }

  @media (max-width: 560px) {
    .timeline-card .experience-skill-list {
      margin-left: 0;
    }
  }
</style>
