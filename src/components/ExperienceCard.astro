---
interface ExperienceItem {
  company: string;
  role: string;
  period: string;
  points: string[];
}

interface Props {
  item: ExperienceItem;
}

const { item } = Astro.props;
---

<article class="timeline-card">
  <div class="timeline-head">
    <div>
      <h3>{item.company}</h3>
      <p>{item.role}</p>
    </div>
    <span>{item.period}</span>
  </div>
  <ul>
    {item.points.map((point) => <li>{point}</li>)}
  </ul>
</article>
