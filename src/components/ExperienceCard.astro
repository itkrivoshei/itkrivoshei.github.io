---
const { item } = Astro.props;
const links = item.links ?? [];
---

<article class="timeline-card">
  <div class="timeline-head">
    <div>
      <h3>{item.company}</h3>
      {item.note && <p class="company-note">{item.note}</p>}
      {links.length > 0 && <p class="experience-inline-links">references</p>}
      <p>{item.role}</p>
    </div>
    <span>{item.period}</span>
  </div>
  <ul>
    {item.points.map((point: string) => <li>{point}</li>)}
  </ul>
</article>
