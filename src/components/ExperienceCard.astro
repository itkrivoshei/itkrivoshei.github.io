---
import type { ExperienceItem, ExperiencePoint } from "../data/profile";

interface Props {
  item: ExperienceItem;
}

const { item } = Astro.props as Props;
const links = item.links ?? [];
const skills = item.skills;

const splitPoint = (point: ExperiencePoint) => {
  if (!point.highlight || !point.text.includes(point.highlight)) {
    return { before: point.text, highlight: "", after: "" };
  }

  const [before, after] = point.text.split(point.highlight);

  return { before, highlight: point.highlight, after };
};
---

<article class="timeline-card">
  <div class="timeline-head">
    <div>
      {
        item.href ? (
          <h3>
            <a
              class="text-link company-link experience-blue-link"
              href={item.href}
              target="_blank"
              rel="noreferrer"
            >
              <span>{item.company}</span>
              <span class="experience-link-icon" aria-hidden="true">
                <svg class="external-link-icon" viewBox="0 0 24 24" role="img">
                  <path d="M14 5h5v5" />
                  <path d="m19 5-8 8" />
                  <path d="M12 7H7a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-5" />
                </svg>
              </span>
            </a>
          </h3>
        ) : (
          <h3>{item.company}</h3>
        )
      }

      {item.note && <p class="company-note">{item.note}</p>}

      {
        links.length > 0 && (
          <p class="experience-inline-links">
            references:{" "}
            {links.map((link, index) => (
              <>
                <a class="experience-blue-link" href={link.href} target="_blank" rel="noreferrer">
                  <span>{link.label}</span>
                  <span class="experience-link-icon" aria-hidden="true">
                    <svg class="external-link-icon" viewBox="0 0 24 24" role="img">
                      <path d="M14 5h5v5" />
                      <path d="m19 5-8 8" />
                      <path d="M12 7H7a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-5" />
                    </svg>
                  </span>
                </a>
                {index < links.length - 1 && <span class="link-separator"> / </span>}
              </>
            ))}
          </p>
        )
      }

      <p class="experience-role">{item.role}</p>
    </div>

    <span class="experience-period">{item.period}</span>
  </div>

  <ul class="experience-points">
    {
      item.points.map((point) => {
        const parts = splitPoint(point);

        return (
          <li>
            <span class="terminal-marker" aria-hidden="true">
              ❯
            </span>
            <span>
              {parts.before}
              {parts.highlight && <strong>{parts.highlight}</strong>}
              {parts.after}
            </span>
          </li>
        );
      })
    }
  </ul>

  <ul class="tag-list experience-skill-list" aria-label={`${item.company} skills`}>
    {skills.map((skill) => <li tabindex="0">{skill}</li>)}
  </ul>
</article>

<style is:global>
  .timeline-card .experience-blue-link,
  .timeline-card .experience-blue-link span,
  .timeline-card .experience-blue-link .experience-link-icon,
  .timeline-card .company-link,
  .timeline-card .company-link span,
  .timeline-card .experience-inline-links a,
  .timeline-card .experience-inline-links a span {
    color: var(--terminal-blue) !important;
  }

  .timeline-card .experience-blue-link:hover,
  .timeline-card .experience-blue-link:hover span,
  .timeline-card .experience-blue-link:hover .experience-link-icon,
  .timeline-card .company-link:hover,
  .timeline-card .company-link:hover span,
  .timeline-card .experience-inline-links a:hover,
  .timeline-card .experience-inline-links a:hover span {
    color: #dbeafe !important;
  }

  .timeline-card .experience-role {
    color: var(--terminal-green);
  }

  .timeline-card .timeline-head .experience-period {
    color: var(--muted) !important;
  }

  .timeline-card .experience-points {
    display: grid;
    gap: 0.7rem;
    list-style: none;
    margin: 1rem 0 0;
    padding-left: 0;
  }

  .timeline-card .experience-points li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.65rem;
    color: var(--muted);
    line-height: 1.72;
  }

  .timeline-card .terminal-marker {
    color: var(--terminal-green);
    font-family: var(--mono);
    line-height: 1.72;
    opacity: 0.9;
  }

  .timeline-card .experience-points strong {
    color: #e7ffe4;
    font-weight: 650;
  }

  .timeline-card .experience-skill-list {
    margin: 0.85rem 0 0 1.95rem !important;
    padding-left: 0 !important;
    line-height: 1;
  }

  .timeline-card .experience-skill-list li {
    cursor: default;
    outline: none;
    border-color: rgba(var(--accent-rgb), 0.22) !important;
    background: rgba(var(--accent-rgb), 0.04) !important;
    color: var(--muted) !important;
  }

  .timeline-card .experience-skill-list li:hover,
  .timeline-card .experience-skill-list li:active,
  .timeline-card .experience-skill-list li:focus-visible {
    border-color: rgba(var(--accent-rgb), 0.52) !important;
    background: rgba(var(--accent-rgb), 0.07) !important;
    box-shadow: 0 0 18px rgba(var(--accent-rgb), 0.09) !important;
    color: #e7ffe4 !important;
    transform: scale(1.006);
  }

  .timeline-card .experience-skill-list li:focus-visible {
    box-shadow:
      0 0 0 2px rgba(var(--accent-rgb), 0.16),
      0 0 18px rgba(var(--accent-rgb), 0.09) !important;
  }

  @media (max-width: 560px) {
    .timeline-card .experience-skill-list {
      margin-left: 0 !important;
    }
  }
</style>
