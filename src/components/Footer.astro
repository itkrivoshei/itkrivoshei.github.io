---
import SocialLink from "./SocialLink.astro";
import { availability, profile } from "../data/profile";
import { splitHighlightedText } from "../utils/text";

const footerTextParts = splitHighlightedText(availability.text, availability.highlights);
---

<footer class="footer-block" data-reveal="footer">
  <p>
    {
      footerTextParts.map((part) =>
        part.highlighted ? <strong class="footer-highlight">{part.text}</strong> : part.text,
      )
    }
  </p>
  <div class="link-row">
    {
      profile.links.map((link) => (
        <SocialLink label={link.label} href={link.href} icon={link.icon} />
      ))
    }
  </div>
</footer>
