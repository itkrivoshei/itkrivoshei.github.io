---
import SocialLink from "./SocialLink.astro";
import { availability, profile } from "../data/profile";

const renderText = () => {
  const matches = availability.highlights
    .filter((highlight) => availability.text.includes(highlight))
    .map((highlight) => ({ highlight, index: availability.text.indexOf(highlight) }))
    .sort((a, b) => a.index - b.index);

  const parts: Array<{ text: string; highlighted: boolean }> = [];
  let cursor = 0;

  matches.forEach(({ highlight, index }) => {
    if (index < cursor) return;

    if (index > cursor) {
      parts.push({ text: availability.text.slice(cursor, index), highlighted: false });
    }

    parts.push({ text: highlight, highlighted: true });
    cursor = index + highlight.length;
  });

  if (cursor < availability.text.length) {
    parts.push({ text: availability.text.slice(cursor), highlighted: false });
  }

  return parts;
};

const footerTextParts = renderText();
---

<footer class="footer-block">
  <p>
    {
      footerTextParts.map((part) =>
        part.highlighted ? <strong class="footer-highlight">{part.text}</strong> : part.text,
      )
    }
  </p>
  <div class="link-row">
    {profile.links.map((link) => <SocialLink label={link.label} href={link.href} />)}
  </div>
</footer>
