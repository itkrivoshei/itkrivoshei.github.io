---
import SocialLink from './SocialLink.astro';
import { profile } from '../data/profile';
---

<footer class="footer-block">
  <p>Open to DevOps, Cloud, Platform, Build and Release, and Software Engineering roles with DevOps focus.</p>
  <div class="link-row">
    {profile.links.map((link) => <SocialLink label={link.label} href={link.href} />)}
  </div>
</footer>
