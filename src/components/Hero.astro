---
import SocialLink from "./SocialLink.astro";
import TerminalTypewriter from "./TerminalTypewriter.astro";
import { profile } from "../data/profile";
---

<section class="hero-card">
  <div>
    <p class="eyebrow">~/profile on main</p>
    <h1>{profile.name}</h1>
    <p class="role">{profile.role}</p>
    <p class="summary">{profile.summary}</p>
    <div class="link-row">
      {
        profile.links.map((link) => (
          <SocialLink label={link.label} href={link.href} icon={link.icon} />
        ))
      }
    </div>
  </div>
  <div class="terminal-card-shell atropos" data-atropos-terminal>
    <div class="atropos-scale">
      <div class="atropos-rotate">
        <div class="atropos-inner">
          <aside class="terminal-card" aria-label="Profile metadata">
            <div class="terminal-dots" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <TerminalTypewriter />
          </aside>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .terminal-card-shell,
  .terminal-card-shell .atropos-scale,
  .terminal-card-shell .atropos-rotate,
  .terminal-card-shell .atropos-inner,
  .terminal-card-shell .terminal-card {
    min-height: 100%;
  }

  .terminal-card-shell {
    border-radius: var(--radius-card);
  }
</style>
