---
import SocialLink from "./SocialLink.astro";
import { profile } from "../data/profile";
---

<section class="hero-card">
  <div>
    <p class="eyebrow">~/profile on main</p>
    <h1>{profile.name}</h1>
    <p class="role">{profile.role}</p>
    <p class="summary">{profile.summary}</p>
    <div class="link-row">
      {profile.links.map((link) => <SocialLink label={link.label} href={link.href} />)}
    </div>
  </div>
  <aside class="terminal-card" aria-label="Profile metadata">
    <div class="terminal-dots" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <p><span>role</span>=devops-focused-engineer</p>
    <p><span>location</span>=berlin</p>
    <p><span>focus</span>=ci-cd linux docker cloud</p>
    <p class="typewriter-line" data-typewriter="$ deploy portfolio --target github-pages">
      <span class="typewriter-text">$ deploy portfolio --target github-pages</span><span
        class="typewriter-cursor"
        aria-hidden="true">_</span
      >
    </p>
  </aside>
</section>

<script>
  const typewriterLine = document.querySelector<HTMLElement>("[data-typewriter]");
  const typewriterText = typewriterLine?.querySelector<HTMLElement>(".typewriter-text");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (typewriterLine && typewriterText && !reduceMotion.matches) {
    const text = typewriterLine.dataset.typewriter ?? "";
    let index = 0;

    typewriterText.textContent = "";

    const typeNextCharacter = () => {
      typewriterText.textContent = text.slice(0, index);
      index += 1;

      if (index <= text.length) {
        window.setTimeout(typeNextCharacter, 38 + Math.random() * 28);
      }
    };

    window.setTimeout(typeNextCharacter, 450);
  }
</script>

<style>
  .typewriter-line {
    min-height: 1.55rem;
    color: var(--terminal-green);
  }

  .typewriter-line .typewriter-text {
    color: var(--terminal-green);
  }

  .typewriter-cursor {
    display: inline-block;
    color: var(--terminal-green) !important;
    animation: cursor-blink 1s steps(2, start) infinite;
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter-cursor {
      animation: none;
    }
  }
</style>
