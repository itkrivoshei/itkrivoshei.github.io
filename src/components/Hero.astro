---
import { profile } from "../data/profile";
import SocialLink from "./SocialLink.astro";
import TerminalTypewriter from "./TerminalTypewriter.astro";
---

<section class="hero-card">
  <p class="eyebrow">~/profile on main</p>
  <h1>{profile.name}</h1>
  <div class="hero-content">
    <div class="hero-left">
      <p class="role">{profile.role}</p>
      <p class="summary">{profile.summary}</p>
      <div class="link-row">
        {
          profile.links.map((link) => (
            <SocialLink label={link.label} href={link.href} icon={link.icon} />
          ))
        }
      </div>
    </div>
    <div class="hero-right">
      <div class="terminal-card-shell">
        <aside class="terminal-card" aria-label="Profile metadata">
          <div class="terminal-dots" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <TerminalTypewriter />
        </aside>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-card {
    display: grid;
    grid-template-columns: 1fr;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .hero-card .eyebrow,
  .hero-card h1 {
    grid-column: 1 / -1;
  }

  .hero-card .eyebrow {
    margin: 0;
  }

  .hero-card h1 {
    margin: 0.45rem 0 0;
    font-size: clamp(3rem, 6.2vw, 4.9rem);
  }

  .hero-content {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.92fr);
    align-items: center;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .hero-left {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .hero-left .link-row {
    display: flex;
    width: 100%;
    min-width: 0;
    flex-wrap: nowrap;
    gap: clamp(0.38rem, 0.8vw, 0.65rem);
    margin-top: 1.25rem;
  }

  .hero-right {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
  }

  .terminal-card-shell,
  .terminal-card-shell .terminal-card {
    width: 100%;
    max-width: 100%;
  }

  .terminal-card-shell {
    border-radius: var(--radius-card);
  }

  :global(.hero-card .link-row a) {
    min-width: 0;
    flex: 1 1 0;
    gap: clamp(0.32rem, 0.75vw, 0.5rem);
    padding: 0.62rem clamp(0.5rem, 1vw, 0.82rem);
    white-space: nowrap;
  }

  :global(.hero-card .link-row .link-icon),
  :global(.hero-card .link-row .link-icon svg) {
    width: clamp(0.88rem, 1.3vw, 1.05rem);
    height: clamp(0.88rem, 1.3vw, 1.05rem);
  }

  @media (max-width: 1023px) {
    .hero-content {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .hero-card {
      padding: 1.25rem;
    }

    .hero-card h1 {
      font-size: clamp(2.9rem, 15vw, 4.1rem);
    }

    .hero-left .link-row {
      gap: 0.35rem;
    }

    :global(.hero-card .link-row a) {
      padding: 0.58rem 0.46rem;
      font-size: 0.82rem;
    }
  }

  @media (max-width: 390px) {
    :global(.hero-card .link-row a) {
      font-size: 0.76rem;
    }
  }
</style>
