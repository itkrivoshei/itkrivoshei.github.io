---
import { heroLinks, profile } from "../data/profile";
import ProfileLinks from "./ProfileLinks.astro";
import TerminalTypewriter from "./TerminalTypewriter.astro";
---

<section class="hero-card">
  <p class="eyebrow">~/profile on main</p>
  <h1>{profile.name}</h1>
  <div class="hero-content">
    <div class="hero-left">
      <p class="role">{profile.role}</p>
      <p class="summary">{profile.summary}</p>
      <ProfileLinks class="hero-profile-links" links={heroLinks} />
    </div>
    <div class="hero-right">
      <div class="terminal-card-shell">
        <aside class="terminal-card" aria-label="Profile metadata">
          <div class="terminal-dots" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <TerminalTypewriter />
        </aside>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-card {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: clamp(0.5rem, 1vw, 0.75rem);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .hero-card .eyebrow,
  .hero-card h1 {
    grid-column: 1 / -1;
  }

  .hero-card .eyebrow {
    margin: 0;
  }

  .hero-card h1 {
    margin: 0.45rem 0 0;
    font-size: clamp(3rem, 6.2vw, 4.9rem);
  }

  .hero-content {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.92fr);
    align-items: center;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .hero-left {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .hero-right {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
  }

  .terminal-card-shell,
  .terminal-card-shell .terminal-card {
    width: 100%;
    max-width: 100%;
  }

  .terminal-card-shell {
    border-radius: var(--radius-card);
  }

  @media (max-width: 1119px) {
    .hero-content {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .hero-card {
      padding: 1.25rem;
    }

    .hero-card h1 {
      font-size: clamp(2.9rem, 15vw, 4.1rem);
    }
  }
</style>
