  }

  @media (max-width: 1023px), (hover: none), (pointer: coarse) {
    .background-grid {
      background-size:
        64px 64px,
        64px 64px,
        16px 16px,
        16px 16px;
      opacity: 0.7;
    }

    .network-background .network-effect {
      pointer-events: none;
    }
