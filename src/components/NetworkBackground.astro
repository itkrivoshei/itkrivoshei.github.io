<div
  class="network-background"
  data-network-background
  data-network-mode="static"
  aria-hidden="true"
>
</div>

<script>
  import { tsParticles, type Container, type ISourceOptions } from "@tsparticles/engine";
  import { loadSlim } from "@tsparticles/slim";

  const background = document.querySelector<HTMLElement>("[data-network-background]");
  const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
  const desktopWidthQuery = window.matchMedia("(min-width: 760px)");
  const finePointerQuery = window.matchMedia("(hover: hover) and (pointer: fine)");
  let container: Container | undefined;
  let slimLoaded = false;
  let activeHover = false;

  const createOptions = (enableHover: boolean) =>
    ({
      autoPlay: true,
      background: {
        color: {
          value: "transparent",
        },
      },
      clear: true,
      detectRetina: true,
      fpsLimit: 40,
      fullScreen: {
        enable: false,
      },
      interactivity: {
        detectsOn: "canvas",
        events: {
          onHover: {
            enable: enableHover,
            mode: "repulse",
          },
          resize: {
            enable: true,
          },
        },
        modes: {
          repulse: {
            distance: 96,
            duration: 0.2,
            speed: 0.16,
          },
        },
      },
      particles: {
        color: {
          value: ["#89b4fa", "#89b4fa", "#89b4fa", "#94e2d5", "#a6e3a1"],
        },
        links: {
          color: "#89b4fa",
          distance: 152,
          enable: true,
          opacity: 0.18,
          width: 1.08,
        },
        move: {
          direction: "none",
          enable: true,
          outModes: {
            default: "bounce",
          },
          random: false,
          speed: {
            min: 0.1,
            max: 0.24,
          },
          straight: false,
        },
        number: {
          density: {
            enable: true,
            height: 720,
            width: 1040,
          },
          value: 62,
        },
        opacity: {
          value: {
            min: 0.26,
            max: 0.52,
          },
        },
        shape: {
          type: "circle",
        },
        size: {
          value: {
            min: 1.2,
            max: 3,
          },
        },
      },
      pauseOnBlur: true,
      pauseOnOutsideViewport: true,
    }) satisfies ISourceOptions;

  const destroyNetwork = () => {
    container?.destroy();
    container = undefined;
    activeHover = false;
  };

  const syncNetwork = async () => {
    if (!background || reducedMotionQuery.matches || !desktopWidthQuery.matches) {
      destroyNetwork();
      background?.setAttribute("data-network-mode", "static");
      return;
    }

    background.setAttribute("data-network-mode", "animated");

    const enableHover = finePointerQuery.matches;

    if (container && !container.destroyed && activeHover === enableHover) {
      return;
    }

    destroyNetwork();

    if (!slimLoaded) {
      await loadSlim(tsParticles);
      slimLoaded = true;
    }

    container = await tsParticles.load({
      element: background,
      id: "network-background",
      options: createOptions(enableHover),
    });
    activeHover = enableHover;
  };

  const scheduleSync = () => {
    void syncNetwork();
  };

  scheduleSync();
  reducedMotionQuery.addEventListener("change", scheduleSync);
  desktopWidthQuery.addEventListener("change", scheduleSync);
  finePointerQuery.addEventListener("change", scheduleSync);
  window.addEventListener("pagehide", destroyNetwork);
</script>
