<div
  class="network-background"
  data-network-background
  data-network-mode="static"
  aria-hidden="true"
>
  <div class="ambient-glow"></div>
  <div class="background-grid"></div>
  <div class="network-effect" data-network-effect></div>
  <div class="background-depth"></div>
  <div class="background-noise"></div>
  <div class="background-vignette"></div>
</div>

<style is:global>
  :root {
    --scroll-depth: 0;
  }

  .background-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(137, 180, 250, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(137, 180, 250, 0.04) 1px, transparent 1px),
      linear-gradient(rgba(148, 163, 184, 0.014) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 163, 184, 0.014) 1px, transparent 1px);
    background-size:
      56px 56px,
      56px 56px,
      14px 14px,
      14px 14px;
    opacity: calc(0.92 - var(--scroll-depth) * 0.28);
    mask-image: radial-gradient(circle at 50% 42%, black 0%, black 60%, transparent 90%);
  }

  .network-background .ambient-glow {
    background:
      radial-gradient(ellipse at 50% 18%, rgba(116, 199, 236, 0.095), transparent 58%),
      radial-gradient(ellipse at 18% 72%, rgba(166, 227, 161, 0.045), transparent 52%),
      radial-gradient(ellipse at 82% 64%, rgba(137, 180, 250, 0.052), transparent 50%);
  }

  .network-background .network-effect {
    z-index: 1;
    pointer-events: none;
  }

  .background-depth {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        rgba(2, 6, 23, 0),
        rgba(2, 6, 23, calc(var(--scroll-depth) * 0.34))
      ),
      radial-gradient(
        circle at 50% 42%,
        transparent 34%,
        rgba(1, 4, 13, calc(var(--scroll-depth) * 0.22)) 76%,
        rgba(1, 4, 13, calc(0.08 + var(--scroll-depth) * 0.28))
      );
  }

  .network-background .background-noise {
    z-index: 3;
    opacity: 0.016;
  }

  .network-background .background-vignette {
    z-index: 4;
    background: radial-gradient(
      circle at 50% 42%,
      transparent 30%,
      rgba(1, 4, 13, calc(0.14 + var(--scroll-depth) * 0.12)) 68%,
      rgba(1, 4, 13, calc(0.54 + var(--scroll-depth) * 0.18))
    );
  }

  body .hero-card,
  body .section-block,
  body .footer-block,
  body .terminal-card,
  body .content-card,
  body .timeline-card {
    background:
      linear-gradient(135deg, rgba(15, 23, 42, 0.45), rgba(2, 6, 23, 0.2)),
      rgba(2, 6, 23, 0.34) !important;
    border-color: rgba(148, 163, 184, 0.16) !important;
    box-shadow:
      0 28px 96px rgba(1, 4, 13, 0.42),
      0 0 0 1px rgba(137, 180, 250, 0.035),
      inset 0 1px 0 rgba(255, 255, 255, 0.055) !important;
    backdrop-filter: blur(20px) saturate(145%) !important;
    -webkit-backdrop-filter: blur(20px) saturate(145%) !important;
  }

  body .hero-card {
    background:
      linear-gradient(135deg, rgba(15, 23, 42, 0.44), rgba(2, 6, 23, 0.18)),
      rgba(2, 6, 23, 0.32) !important;
  }

  body .section-block,
  body .section-about,
  body .section-skills,
  body .section-experience,
  body .section-projects {
    background:
      linear-gradient(135deg, rgba(15, 23, 42, 0.4), rgba(2, 6, 23, 0.16)),
      rgba(2, 6, 23, 0.3) !important;
  }

  body .section-block::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.045), transparent 34%),
      radial-gradient(circle at 12% 0%, rgba(137, 180, 250, 0.08), transparent 34rem);
    opacity: 0.72;
  }

  body .content-card,
  body .timeline-card {
    background:
      linear-gradient(145deg, rgba(15, 23, 42, 0.5), rgba(2, 6, 23, 0.24)),
      rgba(15, 23, 42, 0.3) !important;
    backdrop-filter: blur(16px) saturate(135%) !important;
    -webkit-backdrop-filter: blur(16px) saturate(135%) !important;
  }

  body .terminal-card {
    background:
      linear-gradient(145deg, rgba(3, 7, 18, 0.58), rgba(0, 0, 0, 0.34)),
      rgba(0, 0, 0, 0.28) !important;
  }

  body .skill-card:hover,
  body .project-card:hover,
  body .timeline-card:hover {
    background:
      linear-gradient(145deg, rgba(15, 23, 42, 0.56), rgba(2, 6, 23, 0.25)),
      rgba(15, 23, 42, 0.34) !important;
    border-color: rgba(var(--surface-glow-rgb), 0.46) !important;
    box-shadow:
      0 0 0 1px rgba(var(--surface-glow-rgb), 0.12),
      0 24px 70px rgba(2, 6, 23, 0.46),
      0 0 34px rgba(var(--surface-glow-rgb), 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.055) !important;
  }

  body .section-block:hover {
    border-color: rgba(var(--link-rgb), 0.38) !important;
    background:
      linear-gradient(135deg, rgba(15, 23, 42, 0.48), rgba(2, 6, 23, 0.22)),
      rgba(2, 6, 23, 0.34) !important;
    box-shadow:
      0 30px 100px rgba(1, 4, 13, 0.52),
      0 0 42px rgba(var(--link-rgb), 0.085),
      0 0 0 1px rgba(var(--link-rgb), 0.075),
      inset 0 1px 0 rgba(255, 255, 255, 0.06) !important;
  }

  @media (max-width: 1023px), (hover: none), (pointer: coarse) {
    .background-grid {
      background-size:
        64px 64px,
        64px 64px,
        16px 16px,
        16px 16px;
      opacity: 0.64;
    }
  }
</style>

<script>
  import "../scripts/network-background";
</script>
