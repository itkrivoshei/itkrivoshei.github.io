<div
  class="network-background"
  data-network-background
  data-network-mode="static"
  aria-hidden="true"
>
  <div class="ambient-glow"></div>
  <div class="background-grid"></div>
  <div class="network-effect" data-network-effect></div>
  <div class="background-depth"></div>
  <div class="background-noise"></div>
  <div class="background-vignette"></div>
</div>

<style is:global>
  :root {
    --scroll-depth: 0;
  }

  .background-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(137, 180, 250, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(137, 180, 250, 0.04) 1px, transparent 1px),
      linear-gradient(rgba(148, 163, 184, 0.014) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 163, 184, 0.014) 1px, transparent 1px);
    background-size:
      56px 56px,
      56px 56px,
      14px 14px,
      14px 14px;
    opacity: calc(0.92 - var(--scroll-depth) * 0.28);
    mask-image: radial-gradient(circle at 50% 42%, black 0%, black 60%, transparent 90%);
  }

  .network-background .ambient-glow {
    background:
      radial-gradient(ellipse at 50% 18%, rgba(116, 199, 236, 0.095), transparent 58%),
      radial-gradient(ellipse at 18% 72%, rgba(166, 227, 161, 0.045), transparent 52%),
      radial-gradient(ellipse at 82% 64%, rgba(137, 180, 250, 0.052), transparent 50%);
  }

  .network-background .network-effect {
    z-index: 1;
    pointer-events: none;
  }

  .background-depth {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        rgba(2, 6, 23, 0),
        rgba(2, 6, 23, calc(var(--scroll-depth) * 0.34))
      ),
      radial-gradient(
        circle at 50% 42%,
        transparent 34%,
        rgba(1, 4, 13, calc(var(--scroll-depth) * 0.22)) 76%,
        rgba(1, 4, 13, calc(0.08 + var(--scroll-depth) * 0.28))
      );
  }

  .network-background .background-noise {
    z-index: 3;
    opacity: 0.016;
  }

  .network-background .background-vignette {
    z-index: 4;
    background: radial-gradient(
      circle at 50% 42%,
      transparent 30%,
      rgba(1, 4, 13, calc(0.14 + var(--scroll-depth) * 0.12)) 68%,
      rgba(1, 4, 13, calc(0.54 + var(--scroll-depth) * 0.18))
    );
  }

  .hero-card,
  .section-block,
  .footer-block,
  .terminal-card,
  .content-card,
  .timeline-card {
    background:
      linear-gradient(135deg, rgba(15, 23, 42, 0.56), rgba(2, 6, 23, 0.34)),
      rgba(2, 6, 23, 0.48);
    border-color: rgba(148, 163, 184, 0.18);
    box-shadow:
      0 24px 90px rgba(1, 4, 13, 0.42),
      0 0 0 1px rgba(137, 180, 250, 0.035),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(18px) saturate(138%);
    -webkit-backdrop-filter: blur(18px) saturate(138%);
  }

  .hero-card {
    background:
      linear-gradient(135deg, rgba(15, 23, 42, 0.54), rgba(2, 6, 23, 0.3)),
      rgba(2, 6, 23, 0.44);
  }

  .section-about,
  .section-skills,
  .section-experience,
  .section-projects {
    background:
      linear-gradient(135deg, rgba(15, 23, 42, 0.52), rgba(2, 6, 23, 0.32)),
      rgba(2, 6, 23, 0.44);
  }

  .content-card,
  .timeline-card {
    background:
      linear-gradient(145deg, rgba(15, 23, 42, 0.58), rgba(2, 6, 23, 0.38)),
      rgba(15, 23, 42, 0.42);
    backdrop-filter: blur(14px) saturate(128%);
    -webkit-backdrop-filter: blur(14px) saturate(128%);
  }

  .terminal-card {
    background:
      linear-gradient(145deg, rgba(3, 7, 18, 0.66), rgba(0, 0, 0, 0.44)),
      rgba(0, 0, 0, 0.34);
  }

  .skill-card:hover,
  .project-card:hover,
  .timeline-card:hover {
    background:
      linear-gradient(145deg, rgba(15, 23, 42, 0.62), rgba(2, 6, 23, 0.34)),
      rgba(15, 23, 42, 0.42);
    border-color: rgba(var(--surface-glow-rgb), 0.46);
    box-shadow:
      0 0 0 1px rgba(var(--surface-glow-rgb), 0.11),
      0 24px 68px rgba(2, 6, 23, 0.42),
      0 0 34px rgba(var(--surface-glow-rgb), 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .section-block:hover {
    border-color: rgba(var(--link-rgb), 0.34);
    box-shadow:
      0 28px 96px rgba(1, 4, 13, 0.48),
      0 0 40px rgba(var(--link-rgb), 0.075),
      inset 0 1px 0 rgba(255, 255, 255, 0.045);
  }

  @media (max-width: 1023px), (hover: none), (pointer: coarse) {
    .background-grid {
      background-size:
        64px 64px,
        64px 64px,
        16px 16px,
        16px 16px;
      opacity: 0.64;
    }
  }
</style>

<script>
  import "../scripts/network-background";
</script>
