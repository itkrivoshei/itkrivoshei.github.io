---
import { profile, type SocialLink as SocialLinkData } from "../data/profile";
import SocialLink from "./SocialLink.astro";

interface Props {
  class?: string;
  links?: SocialLinkData[];
}

const { class: className, links = profile.links } = Astro.props;
---

<div class:list={["link-row", "profile-link-row", className]}>
  {links.map((link) => <SocialLink label={link.label} href={link.href} icon={link.icon} />)}
</div>

<style>
  .profile-link-row {
    display: flex;
    width: 100%;
    min-width: 0;
    flex-wrap: nowrap;
    gap: clamp(0.35rem, 0.8vw, 0.65rem);
    margin-top: 1.5rem;
  }

  .profile-link-row.hero-profile-links {
    margin-top: 1.25rem;
  }

  :global(.profile-link-row a) {
    min-width: 0;
    flex: 1 1 0;
    gap: clamp(0.3rem, 0.7vw, 0.5rem);
    padding: 0.62rem clamp(0.48rem, 1vw, 0.82rem);
    white-space: nowrap;
  }

  :global(.profile-link-row .link-icon),
  :global(.profile-link-row .link-icon svg) {
    width: clamp(0.86rem, 1.3vw, 1.05rem);
    height: clamp(0.86rem, 1.3vw, 1.05rem);
  }

  @media (max-width: 560px) {
    .profile-link-row {
      gap: 0.35rem;
    }

    :global(.profile-link-row a) {
      padding: 0.58rem 0.46rem;
      font-size: 0.82rem;
    }
  }

  @media (max-width: 390px) {
    :global(.profile-link-row a) {
      font-size: 0.76rem;
    }
  }

  @media (max-width: 380px) {
    .profile-link-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    :global(.profile-link-row a) {
      width: 100%;
    }
  }
</style>
