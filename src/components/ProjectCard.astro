---
interface ProjectLink {
  label: string;
  href: string;
}

interface ProjectItem {
  name: string;
  repo: string;
  description: string;
  highlight?: string;
  tags: string[];
  links?: ProjectLink[];
  href?: string;
}

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
const links = project.links ?? (project.href ? [{ label: "Repository", href: project.href }] : []);

const getLinkType = (label: string) =>
  label.toLowerCase().includes("repository") ? "repo" : "site";

const getLinkLabel = (label: string) => (getLinkType(label) === "repo" ? "GitHub" : label);

const splitDescription = () => {
  if (!project.highlight || !project.description.includes(project.highlight)) {
    return { before: project.description, highlight: "", after: "" };
  }

  const [before, after] = project.description.split(project.highlight);

  return { before, highlight: project.highlight, after };
};

const description = splitDescription();
---

<article class="content-card project-card">
  <div class="project-copy">
    <p class="eyebrow">{project.repo}</p>
    <h3>{project.name}</h3>
    <p>
      {description.before}
      {description.highlight && <strong>{description.highlight}</strong>}
      {description.after}
    </p>
  </div>

  <ul class="tag-list">
    {project.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  {
    links.length > 0 && (
      <div class="mini-link-row project-links">
        {links.map((link) => {
          const linkType = getLinkType(link.label);

          return (
            <a href={link.href} target="_blank" rel="noreferrer" data-link-type={linkType}>
              <span class="link-icon" aria-hidden="true">
                {linkType === "repo" ? (
                  <svg viewBox="0 0 24 24" role="img">
                    <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.1-1.47-1.1-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.9.83.09-.64.35-1.08.64-1.33-2.22-.25-4.55-1.1-4.55-4.92 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.5 9.5 0 0 1 12 7.03c.85 0 1.7.11 2.5.34 1.9-1.29 2.74-1.02 2.74-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.83-2.34 4.67-4.57 4.92.36.31.68.92.68 1.86v2.56c0 .26.18.58.69.48A10 10 0 0 0 12 2Z" />
                  </svg>
                ) : (
                  <svg class="external-link-icon" viewBox="0 0 24 24" role="img">
                    <path d="M14 5h5v5" />
                    <path d="m19 5-8 8" />
                    <path d="M12 7H7a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-5" />
                  </svg>
                )}
              </span>
              {getLinkLabel(link.label)}
            </a>
          );
        })}
      </div>
    )
  }
</article>
