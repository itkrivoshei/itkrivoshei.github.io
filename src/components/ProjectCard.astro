---
const project = Astro.props.project;
---

<article class="content-card project-card">
  <p class="eyebrow">{project.repo}</p>
  <h3>{project.name}</h3>
  <p>{project.description}</p>
  <ul class="tag-list">
    {project.tags.map((tag) => <li>{tag}</li>)}
  </ul>
  <a class="inline-link" href={project.href}>Repository</a>
</article>
