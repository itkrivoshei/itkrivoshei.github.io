---
interface ProjectLink {
  label: string;
  href: string;
}

interface ProjectItem {
  name: string;
  repo: string;
  description: string;
  tags: string[];
  links?: ProjectLink[];
  href?: string;
}

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
const links = project.links ?? (project.href ? [{ label: 'Repository', href: project.href }] : []);

const getLinkType = (label: string) =>
  label.toLowerCase().includes('repository') ? 'repo' : 'site';
---

<article class="content-card project-card">
  <div class="project-copy">
    <p class="eyebrow">{project.repo}</p>
    <h3>{project.name}</h3>
    <p>{project.description}</p>
  </div>

  <ul class="tag-list">
    {project.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  {
    links.length > 0 && (
      <div class="mini-link-row project-links">
        {links.map((link) => (
          <a href={link.href} target="_blank" rel="noreferrer" data-link-type={getLinkType(link.label)}>
            <span class="link-icon" aria-hidden="true">
              {getLinkType(link.label) === 'repo' ? 'gh' : '↗'}
            </span>
            {link.label}
          </a>
        ))}
      </div>
    )
  }
</article>