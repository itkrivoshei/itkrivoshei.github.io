---
import SocialLink from './SocialLink.astro';

interface ProjectItem {
  name: string;
  repo: string;
  description: string;
  tags: string[];
  href: string;
}

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
---

<article class="content-card project-card">
  <div>
    <p class="eyebrow">{project.repo}</p>
    <h3>{project.name}</h3>
    <p>{project.description}</p>
  </div>
  <ul class="tag-list">
    {project.tags.map((tag) => <li>{tag}</li>)}
  </ul>
  <div class="project-link">
    <SocialLink label="GitHub" href={project.href} />
  </div>
</article>
