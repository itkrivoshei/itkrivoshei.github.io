---
interface ProjectItem {
  name: string;
  repo: string;
  description: string;
  tags: string[];
  href: string;
}

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
---

<article class="content-card project-card">
  <div>
    <p class="eyebrow">{project.repo}</p>
    <h3>{project.name}</h3>
    <p>{project.description}</p>
  </div>
  <ul class="tag-list">
    {project.tags.map((tag) => <li>{tag}</li>)}
  </ul>
  <a class="inline-link project-link" href={project.href} target="_blank" rel="noreferrer">
    <span class="link-icon link-icon-github" aria-hidden="true"></span>
    Repository
  </a>
</article>
