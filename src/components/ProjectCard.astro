---
import Icon from "./Icon.astro";
import type { ProjectItem } from "../data/profile";

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props as Props;
const links = project.links ?? (project.href ? [{ label: "Repository", href: project.href }] : []);
const primaryLink = links[0];

const getLinkType = (label: string) =>
  label.toLowerCase().includes("repository") ? "repo" : "site";

const getLinkLabel = (label: string) => (getLinkType(label) === "repo" ? "GitHub" : label);

const splitDescription = () => {
  if (!project.highlight || !project.description.includes(project.highlight)) {
    return [{ text: project.description, highlighted: false }];
  }

  const [before, after] = project.description.split(project.highlight);

  return [
    { text: before, highlighted: false },
    { text: project.highlight, highlighted: true },
    { text: after, highlighted: false },
  ];
};

const descriptionParts = splitDescription();
---

<article
  class:list={["content-card", "project-card", project.featured && "project-card-featured"]}
  data-reveal="card"
>
  {project.featured && <span class="featured-card-glow" aria-hidden="true" />}

  <div class="project-copy">
    {
      project.featured && (
        <span class="featured-badge">
          <span class="featured-star" aria-hidden="true">
            ★
          </span>
          <span>Featured</span>
        </span>
      )
    }

    <p class="eyebrow">
      {
        primaryLink ? (
          <a class="project-repo-link" href={primaryLink.href} target="_blank" rel="noreferrer">
            <span>{project.repo}</span>
            <span class="link-icon" aria-hidden="true">
              <Icon name="external-link" class="external-link-icon" />
            </span>
          </a>
        ) : (
          project.repo
        )
      }
    </p>
    <h3>{project.name}</h3>
    <p class="project-description">
      {
        descriptionParts.map((part) =>
          part.highlighted ? <strong>{part.text}</strong> : part.text,
        )
      }
    </p>
  </div>

  <ul class="tag-list project-tag-list">
    {project.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  {
    links.length > 0 && (
      <div class="mini-link-row project-links">
        {links.map((link) => {
          const linkType = getLinkType(link.label);

          return (
            <a href={link.href} target="_blank" rel="noreferrer" data-link-type={linkType}>
              <span class="link-icon" aria-hidden="true">
                <Icon
                  name={linkType === "repo" ? "github" : "external-link"}
                  class={linkType === "repo" ? undefined : "external-link-icon"}
                />
              </span>
              {getLinkLabel(link.label)}
            </a>
          );
        })}
      </div>
    )
  }
</article>

<style>
  .project-card-featured:hover {
    --surface-glow-rgb: var(--accent-rgb);
  }

  .project-card-featured:hover .project-copy::after {
    background: var(--terminal-green);
    box-shadow: 0 0 18px rgba(166, 227, 161, 0.68);
  }

  .featured-card-glow {
    position: absolute;
    top: -2.5rem;
    left: -2.25rem;
    z-index: 0;
    width: 8rem;
    height: 8rem;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(166, 227, 161, 0.085), transparent 68%);
    pointer-events: none;
    transition: opacity 700ms ease;
  }

  .project-card-featured:hover .featured-card-glow {
    opacity: 0;
  }

  .featured-badge {
    display: inline-flex;
    width: fit-content;
    min-height: 2.05rem;
    align-items: center;
    justify-content: center;
    gap: 0.38rem;
    margin: 0;
    border: 1px solid rgba(var(--accent-rgb), 0.56);
    border-radius: 999px;
    padding: 0.42rem 0.68rem;
    background: rgba(var(--accent-rgb), 0.11);
    box-shadow:
      0 0 0 1px rgba(var(--accent-rgb), 0.06),
      0 0 20px rgba(var(--accent-rgb), 0.14);
    color: #e7ffe4;
    font-family: var(--mono);
    font-size: 0.85rem;
    line-height: 1;
    letter-spacing: 0;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease,
      box-shadow 160ms ease,
      color 160ms ease;
  }

  .featured-badge:hover {
    border-color: rgba(var(--accent-rgb), 0.76);
    background: rgba(var(--accent-rgb), 0.17);
    box-shadow:
      0 0 0 1px rgba(var(--accent-rgb), 0.12),
      0 0 26px rgba(var(--accent-rgb), 0.22);
    color: #f0ffed;
    transform: scale(1.006);
  }

  .featured-star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--terminal-green);
    font-size: 1.08rem;
    line-height: 1;
    transform: translateY(-0.01em);
  }

  .project-description {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
</style>
