---
interface Props {
  title: string;
}

const { title } = Astro.props;
const sectionClass = `section-${title.toLowerCase().replace(/\s+/g, '-')}`;
---

<section class:list={['section-block', sectionClass]}>
  <div class="section-title">
    <span></span>
    <h2>{title}</h2>
  </div>
  <slot />
</section>
