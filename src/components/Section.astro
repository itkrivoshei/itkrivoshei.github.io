---
interface Props {
  title: string;
  variant: "about" | "skills" | "experience" | "projects";
}

const { title, variant } = Astro.props;
const sectionClass = `section-${variant}`;
---

<section class:list={["section-block", sectionClass]}>
  <div class="section-title" data-reveal="heading">
    <span></span>
    <h2>{title}</h2>
  </div>
  <slot />
</section>
