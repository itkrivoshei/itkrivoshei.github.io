---
interface SkillGroupItem {
  title: string;
  items: string[];
}

interface Props {
  group: SkillGroupItem;
}

const { group } = Astro.props;
---

<article class="content-card">
  <h3>{group.title}</h3>
  <ul class="tag-list">
    {group.items.map((item) => <li>{item}</li>)}
  </ul>
</article>
