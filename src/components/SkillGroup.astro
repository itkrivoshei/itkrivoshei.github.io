---
interface SkillGroupItem {
  title: string;
  icon: string;
  items: string[];
}

interface Props {
  group: SkillGroupItem;
}

const { group } = Astro.props;
---

<article class="content-card skill-card">
  <div class="card-heading">
    <span class="skill-icon" aria-hidden="true">{group.icon}</span>
    <h3>{group.title}</h3>
  </div>
  <ul class="tag-list">
    {group.items.map((item) => <li>{item}</li>)}
  </ul>
</article>