---
import type { SkillGroup as SkillGroupData } from "../data/profile";

interface Props {
  group: SkillGroupData;
}

const { group } = Astro.props as Props;
---

<article class="content-card skill-card skill-row" data-reveal="card">
  <div class="card-heading skill-row-heading">
    <span class="skill-icon" aria-hidden="true">
      {
        group.icon === "cloud" && (
          <svg viewBox="0 0 24 24">
            <path d="M17.5 18H8a5 5 0 0 1-.8-9.94 6.2 6.2 0 0 1 11.72 2.35A3.8 3.8 0 0 1 17.5 18Z" />
            <path d="M12 10v5M9.5 12.5H12l2.5-2.5" />
          </svg>
        )
      }
      {
        group.icon === "container" && (
          <svg viewBox="0 0 24 24">
            <rect x="4" y="5" width="16" height="14" rx="2" />
            <path d="M4 10h16M9 5v14M15 5v14" />
            <path d="M7 7.5h.01M12 7.5h.01M17 7.5h.01" />
          </svg>
        )
      }
      {
        group.icon === "pipeline" && (
          <svg viewBox="0 0 24 24">
            <path d="M7 7h10M7 17h10M7 7v10M17 7v10" />
            <circle cx="7" cy="7" r="2.5" />
            <circle cx="17" cy="7" r="2.5" />
            <circle cx="7" cy="17" r="2.5" />
            <circle cx="17" cy="17" r="2.5" />
          </svg>
        )
      }
      {
        group.icon === "pulse" && (
          <svg viewBox="0 0 24 24">
            <path d="M3 12h4l2-5 4 10 2-5h6" />
            <circle cx="12" cy="12" r="9" />
          </svg>
        )
      }
      {
        group.icon === "code" && (
          <svg viewBox="0 0 24 24">
            <path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14" />
          </svg>
        )
      }
      {
        group.icon === "git" && (
          <svg viewBox="0 0 24 24">
            <circle cx="6" cy="6" r="2.5" />
            <circle cx="18" cy="18" r="2.5" />
            <circle cx="6" cy="18" r="2.5" />
            <path d="M6 8.5v7M8.5 6c4.5 0 7 2.5 7 9.5" />
          </svg>
        )
      }
    </span>
    <h3>{group.title}</h3>
  </div>
  <ul class="tag-list skill-row-tags">
    {group.items.map((item) => <li>{item}</li>)}
  </ul>
</article>

<style>
  :global(.skills-list) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.72rem;
  }

  .skill-row {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 0.85rem;
    padding: 0.95rem 1.05rem;
  }

  .skill-row-heading {
    min-width: 0;
    padding-right: 0;
  }

  .skill-row-heading::after {
    display: none;
  }

  .skill-row-heading h3 {
    font-size: 0.98rem;
    line-height: 1.25;
  }

  .skill-row-tags {
    margin-top: 0;
    gap: 0.42rem;
  }

  .skill-row-tags li {
    padding: 0.38rem 0.62rem;
    font-size: 0.82rem;
    line-height: 1.15;
  }

  @media (min-width: 760px) {
    .skill-row {
      grid-template-columns: minmax(17rem, 0.34fr) minmax(0, 1fr);
    }

    .skill-row-heading h3 {
      white-space: nowrap;
    }
  }
</style>
