---
const command = "deploy engineering-site --target github-pages";
const result = "ready";
---

<div class="terminal-typewriter">
  <p class="typewriter-line typewriter-command-line">
    <span class="terminal-prompt" aria-hidden="true">$</span>
    <span>{command}</span>
  </p>
  <p class="typewriter-line typewriter-result-line">
    <span>{result}</span><span class="typewriter-cursor" aria-hidden="true"></span>
  </p>
</div>

<style>
  .terminal-typewriter {
    display: grid;
    gap: 0.15rem;
    font-size: 0.95rem;
    min-width: 0;
  }

  .typewriter-line {
    min-height: 1.55em;
    max-width: 100%;
    overflow-wrap: anywhere;
    white-space: normal;
  }

  .typewriter-command-line {
    color: var(--muted);
  }

  .typewriter-result-line {
    color: var(--terminal-green);
  }

  .terminal-prompt {
    color: var(--terminal-blue);
  }

  .typewriter-cursor {
    display: inline-block;
    width: 0.58ch;
    height: 1.08em;
    margin-left: 0.18rem;
    border-radius: 0.16rem;
    background: var(--terminal-green);
    box-shadow: 0 0 14px rgba(166, 227, 161, 0.32);
    transform: translateY(0.16em);
    animation: terminal-cursor-blink 1s steps(2, end) infinite;
  }

  @keyframes terminal-cursor-blink {
    0%,
    48% {
      opacity: 1;
    }

    49%,
    100% {
      opacity: 0.28;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typewriter-cursor {
      opacity: 1;
      animation: none;
    }
  }

  @media (max-width: 420px) {
    .terminal-typewriter {
      font-size: 0.82rem;
    }
  }

  @media (max-width: 360px) {
    .terminal-typewriter {
      font-size: 0.76rem;
    }
  }
</style>
