---
import "../styles/global.css";
import NetworkBackground from "../components/NetworkBackground.astro";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  canonical?: string | false;
  image?: string;
  includePersonSchema?: boolean;
  noindex?: boolean;
}

const defaultCanonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.toString();
const {
  title = "Nikita Krivoshei",
  description = "Personal engineering website for DevOps-focused software engineering work.",
  image = Astro.site ? new URL("/og-image.png", Astro.site).toString() : "/og-image.png",
  includePersonSchema = true,
  noindex = false,
} = Astro.props;
const canonical =
  Astro.props.canonical === false ? undefined : (Astro.props.canonical ?? defaultCanonical);
const profileUrl = Astro.site
  ? new URL("/", Astro.site).toString()
  : new URL("/", Astro.url).toString();

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  address: {
    "@type": "PostalAddress",
    addressLocality: profile.location,
  },
  url: profileUrl,
  sameAs: profile.links.filter((link) => link.href.startsWith("https://")).map((link) => link.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.role}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {
      includePersonSchema && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
      )
    }
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <NetworkBackground />
    <slot />
    <script>
      import "../scripts/page-motion";
    </script>
  </body>
</html>

<style is:global>
  .hero-card,
  .section-block,
  .footer-block,
  .terminal-card,
  .content-card,
  .timeline-card {
    border-color: rgba(148, 163, 184, 0.16);
    background:
      linear-gradient(135deg, rgba(15, 23, 42, 0.42), rgba(2, 6, 23, 0.18)),
      rgba(2, 6, 23, 0.34);
    box-shadow:
      0 28px 96px rgba(1, 4, 13, 0.42),
      0 0 0 1px rgba(137, 180, 250, 0.035),
      inset 0 1px 0 rgba(255, 255, 255, 0.055);
  }

  .hero-card,
  .section-block,
  .footer-block,
  .terminal-card {
    backdrop-filter: blur(20px) saturate(145%);
    -webkit-backdrop-filter: blur(20px) saturate(145%);
  }

  .hero-card {
    background:
      linear-gradient(135deg, rgba(15, 23, 42, 0.42), rgba(2, 6, 23, 0.16)),
      rgba(2, 6, 23, 0.3);
  }

  .section-about,
  .section-skills,
  .section-experience,
  .section-projects {
    background:
      linear-gradient(135deg, rgba(15, 23, 42, 0.36), rgba(2, 6, 23, 0.14)),
      rgba(2, 6, 23, 0.26);
  }

  .section-block::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.045), transparent 34%),
      radial-gradient(circle at 12% 0%, rgba(137, 180, 250, 0.08), transparent 34rem);
    opacity: 0.72;
  }

  .content-card,
  .timeline-card {
    background:
      linear-gradient(145deg, rgba(15, 23, 42, 0.46), rgba(2, 6, 23, 0.22)),
      rgba(15, 23, 42, 0.28);
    backdrop-filter: blur(16px) saturate(135%);
    -webkit-backdrop-filter: blur(16px) saturate(135%);
  }

  .terminal-card {
    background:
      linear-gradient(145deg, rgba(3, 7, 18, 0.58), rgba(0, 0, 0, 0.34)),
      rgba(0, 0, 0, 0.28);
  }

  .skill-card:hover,
  .project-card:hover,
  .timeline-card:hover {
    background:
      linear-gradient(145deg, rgba(15, 23, 42, 0.52), rgba(2, 6, 23, 0.24)),
      rgba(15, 23, 42, 0.32);
    box-shadow:
      0 0 0 1px rgba(var(--surface-glow-rgb), 0.12),
      0 24px 70px rgba(2, 6, 23, 0.46),
      0 0 34px rgba(var(--surface-glow-rgb), 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.055);
  }

  .section-block:hover {
    background:
      linear-gradient(135deg, rgba(15, 23, 42, 0.42), rgba(2, 6, 23, 0.18)),
      rgba(2, 6, 23, 0.3);
    box-shadow:
      0 30px 100px rgba(1, 4, 13, 0.52),
      0 0 42px rgba(var(--link-rgb), 0.085),
      0 0 0 1px rgba(var(--link-rgb), 0.075),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }
</style>
