---
import "../styles/global.css";
import "../styles/link-colors.css";
import NetworkBackground from "../components/NetworkBackground.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Nikita Krivoshei",
  description = "Personal engineering website for DevOps-focused software engineering work.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://itkrivoshei.github.io" />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion-ready");
      }
    </script>
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <div class="ambient-layer" aria-hidden="true"></div>
    <NetworkBackground />
    <slot />
    <script>
      const root = document.documentElement;
      const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      const finePointerQuery = window.matchMedia("(hover: hover) and (pointer: fine)");
      const revealTargets = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
      let pointerTrackingEnabled = false;
      let frameId = 0;
      let revealObserver: IntersectionObserver | undefined;

      const setCursorPosition = (clientX: number, clientY: number) => {
        root.style.setProperty("--cursor-x", `${clientX}px`);
        root.style.setProperty("--cursor-y", `${clientY}px`);
      };

      const handlePointerMove = (event: PointerEvent) => {
        if (frameId) return;

        const { clientX, clientY } = event;

        frameId = window.requestAnimationFrame(() => {
          setCursorPosition(clientX, clientY);
          frameId = 0;
        });
      };

      const syncPointerTracking = () => {
        const shouldTrack = !reducedMotionQuery.matches && finePointerQuery.matches;

        if (shouldTrack && !pointerTrackingEnabled) {
          setCursorPosition(window.innerWidth * 0.56, window.innerHeight * 0.24);
          window.addEventListener("pointermove", handlePointerMove, { passive: true });
          pointerTrackingEnabled = true;
          return;
        }

        if (!shouldTrack && pointerTrackingEnabled) {
          window.removeEventListener("pointermove", handlePointerMove);
          if (frameId) {
            window.cancelAnimationFrame(frameId);
            frameId = 0;
          }
          pointerTrackingEnabled = false;
        }
      };

      const showRevealTargets = () => {
        revealTargets.forEach((target) => {
          target.classList.add("is-visible");
        });
      };

      const disconnectRevealObserver = () => {
        revealObserver?.disconnect();
        revealObserver = undefined;
      };

      const syncPageMotion = () => {
        disconnectRevealObserver();

        if (reducedMotionQuery.matches || !("IntersectionObserver" in window)) {
          root.classList.remove("motion-ready");
          showRevealTargets();
          return;
        }

        root.classList.add("motion-ready");

        revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("is-visible");
              revealObserver?.unobserve(entry.target);
            });
          },
          {
            rootMargin: "0px 0px -8% 0px",
            threshold: 0.08,
          },
        );

        revealTargets.forEach((target, index) => {
          const delay =
            target.dataset.reveal === "hero"
              ? 300
              : target.dataset.reveal === "section"
                ? 80
                : Math.min((index % 5) * 42, 168);
          target.style.setProperty("--reveal-delay", `${delay}ms`);
          revealObserver?.observe(target);
        });
      };

      syncPointerTracking();
      syncPageMotion();
      reducedMotionQuery.addEventListener("change", () => {
        syncPointerTracking();
        syncPageMotion();
      });
      finePointerQuery.addEventListener("change", syncPointerTracking);
      window.addEventListener("pagehide", () => {
        disconnectRevealObserver();
        window.removeEventListener("pointermove", handlePointerMove);
      });
    </script>
  </body>
</html>
