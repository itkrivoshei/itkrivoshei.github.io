---
import "../styles/global.css";
import "../styles/link-colors.css";
import NetworkBackground from "../components/NetworkBackground.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Personal GitHub Pages site",
  description = "A small static site built with Astro, TypeScript, Tailwind CSS, and GitHub Pages.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://itkrivoshei.github.io" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <NetworkBackground />
    <slot />
  </body>
</html>
