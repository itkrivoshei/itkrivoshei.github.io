---
import "../styles/global.css";
import NetworkBackground from "../components/NetworkBackground.astro";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  canonical?: string | false;
  image?: string;
  includePersonSchema?: boolean;
  noindex?: boolean;
}

const defaultCanonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.toString();
const {
  title = "Nikita Krivoshei",
  description = "Personal engineering website for DevOps-focused software engineering work.",
  image = Astro.site ? new URL("/og-image.png", Astro.site).toString() : "/og-image.png",
  includePersonSchema = true,
  noindex = false,
} = Astro.props;
const canonical =
  Astro.props.canonical === false ? undefined : (Astro.props.canonical ?? defaultCanonical);
const profileUrl = Astro.site
  ? new URL("/", Astro.site).toString()
  : new URL("/", Astro.url).toString();

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  address: {
    "@type": "PostalAddress",
    addressLocality: profile.location,
  },
  url: profileUrl,
  sameAs: profile.links.filter((link) => link.href.startsWith("https://")).map((link) => link.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.role}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {
      includePersonSchema && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
      )
    }
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <NetworkBackground />
    <slot />
    <script>
      const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      const revealTargets = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
      let revealObserver: IntersectionObserver | undefined;
      let revealFallbackId = 0;

      const showRevealTargets = () => {
        revealTargets.forEach((target) => {
          target.classList.remove("reveal-pending");
          target.classList.add("is-visible");
        });
      };

      const disconnectRevealObserver = () => {
        revealObserver?.disconnect();
        revealObserver = undefined;
        window.clearTimeout(revealFallbackId);
      };

      const syncPageMotion = () => {
        disconnectRevealObserver();

        if (reducedMotionQuery.matches || !("IntersectionObserver" in window)) {
          showRevealTargets();
          return;
        }

        revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.remove("reveal-pending");
              entry.target.classList.add("is-visible");
              revealObserver?.unobserve(entry.target);
            });
          },
          {
            rootMargin: "0px 0px -8% 0px",
            threshold: 0.08,
          },
        );

        revealTargets.forEach((target, index) => {
          if (target.getBoundingClientRect().top < window.innerHeight) {
            target.classList.add("is-visible");
            return;
          }

          const delay = target.dataset.reveal === "section" ? 80 : Math.min((index % 5) * 42, 168);
          target.style.setProperty("--reveal-delay", `${delay}ms`);
          target.classList.remove("is-visible");
          target.classList.add("reveal-pending");
          revealObserver?.observe(target);
        });

        revealFallbackId = window.setTimeout(showRevealTargets, 1800);
      };

      syncPageMotion();
      reducedMotionQuery.addEventListener("change", syncPageMotion);
      window.addEventListener("pagehide", disconnectRevealObserver);
    </script>
  </body>
</html>
