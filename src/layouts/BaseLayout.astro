---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Personal GitHub Pages site',
  description = 'A small static site built with Astro, TypeScript, Tailwind CSS, and GitHub Pages.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://itkrivoshei.github.io" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <div class="cursor-spotlight" aria-hidden="true"></div>
    <slot />
    <script>
      const root = document.documentElement;
      const spotlight = document.querySelector<HTMLElement>('.cursor-spotlight');
      const glowTargets = document.querySelectorAll<HTMLElement>(
        '.hero-card, .section-block, .footer-block, .terminal-card, .content-card, .timeline-card',
      );
      const canAnimateGlow = window.matchMedia(
        '(pointer: fine) and (prefers-reduced-motion: no-preference)',
      ).matches;

      if (spotlight && canAnimateGlow) {
        let targetX = window.innerWidth / 2;
        let targetY = window.innerHeight * 0.12;
        let currentX = targetX;
        let currentY = targetY;
        let hasPointerPosition = false;
        let animationFrame = 0;

        const getGlowStrength = (rect: DOMRect, x: number, y: number) => {
          const dx = Math.max(rect.left - x, 0, x - rect.right);
          const dy = Math.max(rect.top - y, 0, y - rect.bottom);
          const distance = Math.hypot(dx, dy);
          const radius = 260;

          return Math.max(0, 1 - distance / radius);
        };

        const renderGlow = () => {
          currentX += (targetX - currentX) * 0.12;
          currentY += (targetY - currentY) * 0.12;

          spotlight.style.setProperty('--x', `${currentX}px`);
          spotlight.style.setProperty('--y', `${currentY}px`);
          root.style.setProperty('--cursor-x', `${currentX}px`);
          root.style.setProperty('--cursor-y', `${currentY}px`);

          glowTargets.forEach((target) => {
            const rect = target.getBoundingClientRect();
            const glowStrength = hasPointerPosition
              ? getGlowStrength(rect, currentX, currentY)
              : 0;

            target.style.setProperty('--mx', `${currentX - rect.left}px`);
            target.style.setProperty('--my', `${currentY - rect.top}px`);
            target.style.setProperty('--glow-opacity', `${glowStrength * 0.52}`);
            target.style.setProperty(
              '--border-glow-opacity',
              `${glowStrength * 0.72}`,
            );
          });

          animationFrame = window.requestAnimationFrame(renderGlow);
        };

        window.addEventListener(
          'pointermove',
          (event) => {
            hasPointerPosition = true;
            targetX = event.clientX;
            targetY = event.clientY;
          },
          { passive: true },
        );

        window.addEventListener(
          'pointerleave',
          () => {
            hasPointerPosition = false;
          },
          { passive: true },
        );

        animationFrame = window.requestAnimationFrame(renderGlow);

        window.addEventListener('pagehide', () => {
          window.cancelAnimationFrame(animationFrame);
        });
      }
    </script>
  </body>
</html>
