---
import "../styles/global.css";
import NetworkBackground from "../components/NetworkBackground.astro";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  canonical?: string | false;
  image?: string;
  includePersonSchema?: boolean;
  noindex?: boolean;
}

const defaultCanonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.toString();
const {
  title = "Nikita Krivoshei",
  description = "Personal engineering website for DevOps-focused software engineering work.",
  image = Astro.site ? new URL("/og-image.png", Astro.site).toString() : "/og-image.png",
  includePersonSchema = true,
  noindex = false,
} = Astro.props;
const canonical =
  Astro.props.canonical === false ? undefined : (Astro.props.canonical ?? defaultCanonical);
const profileUrl = Astro.site
  ? new URL("/", Astro.site).toString()
  : new URL("/", Astro.url).toString();

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  address: {
    "@type": "PostalAddress",
    addressLocality: profile.location,
  },
  url: profileUrl,
  sameAs: profile.links.filter((link) => link.href.startsWith("https://")).map((link) => link.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.role}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {
      includePersonSchema && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
      )
    }
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <NetworkBackground />
    <slot />
    <script>
      import "../scripts/page-motion";
    </script>
  </body>
</html>
