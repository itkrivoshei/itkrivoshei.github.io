---
import ExperienceCard from "../components/ExperienceCard.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Section from "../components/Section.astro";
import SkillGroup from "../components/SkillGroup.astro";
import { experience, profile, projects, skillGroups } from "../data/profile";
import BaseLayout from "../layouts/BaseLayout.astro";
import { splitHighlightedText } from "../utils/text";
---

<BaseLayout title={profile.name} description={profile.summary}>
  <main class="site-shell">
    <Hero />
    <Section title="About">
      <div class="copy-grid">
        {
          profile.about.map((paragraph) => (
            <p>
              <span class="prompt-label">{paragraph.prompt}&gt;</span>{" "}
              {splitHighlightedText(paragraph.text, paragraph.highlight).map((part) =>
                part.highlighted ? <strong>{part.text}</strong> : part.text,
              )}
            </p>
          ))
        }
      </div>
    </Section>
    <Section title="Skills">
      <div class="skills-list">
        {skillGroups.map((group) => <SkillGroup group={group} />)}
      </div>
    </Section>
    <Section title="Experience">
      <div class="timeline-list">{experience.map((item) => <ExperienceCard item={item} />)}</div>
    </Section>
    <Section title="Selected Engineering Work">
      <div class="card-grid projects-grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </Section>
    <Footer />
  </main>
</BaseLayout>
