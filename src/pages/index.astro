---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main class="mx-auto flex min-h-screen w-full max-w-5xl items-center px-6 py-16">
    <section class="w-full rounded-3xl border border-slate-800 bg-slate-900/70 p-8 shadow-2xl shadow-slate-950/40 md:p-12">
      <p class="text-sm font-medium uppercase tracking-[0.35em] text-sky-300">GitHub Pages</p>
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white md:text-6xl">
        Personal site base
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300">
        Static site baseline built with Astro, TypeScript, Tailwind CSS, and GitHub Pages.
        Resume content and production workflows will be added in the next commits.
      </p>
      <div class="mt-8 flex flex-wrap gap-3 text-sm text-slate-300">
        <span class="rounded-full border border-slate-700 px-4 py-2">Astro</span>
        <span class="rounded-full border border-slate-700 px-4 py-2">TypeScript</span>
        <span class="rounded-full border border-slate-700 px-4 py-2">Tailwind CSS</span>
      </div>
    </section>
  </main>
</BaseLayout>
